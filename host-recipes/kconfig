#! /bin/sh

name=kconfig
from_source=kconfig
imagedeps="build-essential cmake ninja-build pkg-config libdbus-1-dev"
hostdeps="gcc pkg-config qt6 extra-cmake-modules"

configure() {
    cmake -GNinja \
        -DCMAKE_INSTALL_PREFIX=${prefix} \
        -DCMAKE_BUILD_TYPE=Release \
        -DECM_DIR=${prefix}/share/ECM/cmake \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_TESTING=OFF \
        -DBUILD_QCH=FALSE \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DKCONFIG_USE_GUI=OFF \
        -DKCONFIG_USE_QML=OFF \
        -DKF_IGNORE_PLATFORM_CHECK=TRUE \
        "${source_dir}"
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .
}
