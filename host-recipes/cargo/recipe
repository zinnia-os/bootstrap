#! /bin/sh

version=0.101.0
revision=1
git_url="https://github.com/rust-lang/cargo.git"
commit=3d7cf6e937d6127d0f49881bf689c560b36d35c4
imagedeps="build-essential libssl-dev pkg-config cargo"
hostrundeps="gcc rust"
allow_network=yes

prepare_cargo_home() {
    rm -f "${build_dir}/.cargo/config.toml" "${build_dir}/.cargo/config"
    cargo_project_home "$(pwd -P)/.cargo"
}

install_cargo() {
    PKG_CONFIG=/usr/bin/pkg-config \
    CARGO_HOME="$(pwd -P)/.cargo" \
    cargo install \
    --locked \
    --target "${RUST_HOST_TRIPLET}" \
    --target-dir "$(pwd -P)" \
    --path "${source_dir}" \
    -j${parallelism} \
    --root "$1"
}

build() {
    prepare_cargo_home
    install_cargo "${build_dir}/out"
}

package() {
    prepare_cargo_home
    install_cargo "${dest_dir}${prefix}"

    strip_command=strip \
    post_package_strip
}
