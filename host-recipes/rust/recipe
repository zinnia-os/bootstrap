#! /bin/sh

from_source=rust
revision=5
imagedeps="build-essential cmake ninja-build python3 curl git"
hostdeps="pkg-config cargo"
hostrundeps="gcc llvm"
rust_crates="rust-libc rust-rustix rust-getrandom rust-getrandom-03 rust-nix rust-errno rust-socket2 rust-system-deps rust-libloading rust-libloading-09"
deps="core-libs ${rust_crates}"
builddeps="mlibc"
allow_network=yes

prepare_rust_source() {
    rust_src="$(pwd -P)/rust-src"

    if [ -f "${rust_src}/x.py" ]; then
        return
    fi

    rm -rf "${rust_src}"
    cp -a "${source_dir}/." "${rust_src}"

    cargo_fork_root="${rust_src}/library/zinnia-crates"
    mkdir -p "${cargo_fork_root}"
    for fork in ${rust_crates}; do
        cp -a "${sysroot}/usr/src/rust/${fork}" "${cargo_fork_root}/"
    done

    export CARGO_HOME="$(pwd -P)/.cargo"
    mkdir -p "${CARGO_HOME}"
    {
        printf '[patch.crates-io]\n'
        cargo_patch_entries "${cargo_fork_root}" ${rust_crates}
    } > "${CARGO_HOME}/config.toml"
    cargo_patch_entries zinnia-crates ${rust_crates} >> "${rust_src}/library/Cargo.toml"

    for workspace in . library src/bootstrap src/tools/cargo; do
        (
            cd "${rust_src}/${workspace}"
            RUSTC_BOOTSTRAP=1 CARGO_NET_OFFLINE=true cargo_relock ${rust_crates}
        )
    done
}

configure() {
    cat > config.toml << EOF
change-id = "ignore"

[llvm]
targets = "X86;AArch64;RISCV;LoongArch"
link-shared = true
download-ci-llvm = false

[build]
target = ["${RUST_TRIPLET}", "${RUST_HOST_TRIPLET}"]
docs = false
python = "python3"
tools = ["src"]
vendor = true

[install]
prefix = "${prefix}"
sysconfdir = "etc"

[rust]
channel = "nightly"
codegen-tests = false
deny-warnings = false

[target.${RUST_HOST_TRIPLET}]
llvm-config = "${prefix}/bin/llvm-config"

[target.${RUST_TRIPLET}]
llvm-config = "${prefix}/bin/llvm-config"
cc = "${OS_TRIPLET}-gcc"
cxx = "${OS_TRIPLET}-g++"
ar = "${OS_TRIPLET}-ar"
ranlib = "${OS_TRIPLET}-ranlib"
linker = "${OS_TRIPLET}-gcc"
EOF
}

build() {
    prepare_rust_source
    "${rust_src}"/x.py build rustc std --stage 2 -j${parallelism}
}

package() {
    rust_src="$(pwd -P)/rust-src"
    prepare_rust_source

        DESTDIR="${dest_dir}" \
    "${rust_src}"/x.py install rustc std --stage 2 -j${parallelism}

    rm -rf "${dest_dir}${prefix}"/share/doc
    rm -rf "${dest_dir}${prefix}"/share/man

    mkdir -p "${dest_dir}${prefix}"/lib/rustlib/src/rust/library/
    cp -rp "${rust_src}"/library/. "${dest_dir}${prefix}"/lib/rustlib/src/rust/library/
}
