#! /bin/sh

name=kconfig
version=6.25.0
revision=1
git_url="https://github.com/KDE/kconfig.git"
commit=33247bd3fbaee289c839f40f7591453570a50502
imagedeps="cmake ninja-build pkg-config"
hostdeps="gcc pkg-config cmake qt6 extra-cmake-modules"
deps="core-libs qtbase6 qtdeclarative6"

configure() {
    kf6_configure
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    post_package_strip
}
