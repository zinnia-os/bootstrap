#! /bin/sh

name=rust
from_source=rust
revision=3
imagedeps="build-essential cmake ninja-build python3 curl git"
hostdeps="gcc pkg-config llvm cargo rust"
deps="core-libs llvm zlib zstd libffi ncurses openssl curl nghttp2 rust-crates"
builddeps="mlibc"
allow_network=yes

prepare_rust_source() {
    rust_src="$(pwd -P)/rust-src"
    prepare_rust_toolchain_source "${rust_src}" "${sysroot_dir}/usr/src/rust"
    cargo_zinnia_patch_rust_workspace "${rust_src}" \
        ".." "$(dirname "${rust_src}")"
    cargo_zinnia_patch_rust_workspace "${rust_src}/src/tools/cargo" \
        "../../../.." "$(dirname "${rust_src}")"
}

configure() {
    llvm_config_wrapper="$(pwd -P)/zinnia-llvm-config"
    cat > "${llvm_config_wrapper}" << WRAP
#! /bin/sh
for arg in "\$@"; do
    case "\$arg" in
        --prefix)     echo "${sysroot_dir}/usr"; exit 0 ;;
        --libdir)     echo "${sysroot_dir}/usr/lib"; exit 0 ;;
        --bindir)     echo "${sysroot_dir}/usr/bin"; exit 0 ;;
        --includedir) echo "${sysroot_dir}/usr/include"; exit 0 ;;
        --ldflags)    echo "-L${sysroot_dir}/usr/lib"; exit 0 ;;
    esac
done
exec /usr/local/bin/llvm-config "\$@"
WRAP
    chmod +x "${llvm_config_wrapper}"

    cat > config.toml << EOF
change-id = "ignore"

[llvm]
link-shared = true
download-ci-llvm = false

[build]
build = "${RUST_HOST_TRIPLET}"
host = ["${RUST_TRIPLET}"]
target = ["${RUST_TRIPLET}"]
docs = false
python = "python3"
tools = ["cargo"]
sanitizers = false
profiler = false

[install]
prefix = "${prefix}"
sysconfdir = "etc"

[rust]
channel = "nightly"
codegen-tests = false
deny-warnings = false
llvm-tools = false

[target.${RUST_HOST_TRIPLET}]
llvm-config = "/usr/local/bin/llvm-config"

[target.${RUST_TRIPLET}]
llvm-config = "${llvm_config_wrapper}"
cc = "${OS_TRIPLET}-gcc"
cxx = "${OS_TRIPLET}-g++"
ar = "${OS_TRIPLET}-ar"
ranlib = "${OS_TRIPLET}-ranlib"
linker = "${OS_TRIPLET}-gcc"
EOF
}

build() {
    prepare_rust_source

    pkgconf_var="PKG_CONFIG_$(printf '%s' "${RUST_TRIPLET}" | tr - _)"
    rustflags_var="CARGO_TARGET_$(printf '%s' "${RUST_TRIPLET}" | tr '[:lower:]-' '[:upper:]_')_RUSTFLAGS"

        BOOTSTRAP_SKIP_TARGET_SANITY=1 \
        CARGO_HOME="$(pwd -P)/.cargo" \
        PKG_CONFIG_ALLOW_CROSS=1 \
        OPENSSL_NO_VENDOR=1 \
        env "${pkgconf_var}=${OS_TRIPLET}-pkg-config" \
            "${rustflags_var}=${RUST_GETRANDOM_RUSTFLAG}" \
    python3 "${rust_src}"/x.py build rustc cargo std --stage 2 -j${parallelism}
}

package() {
    prepare_rust_source

    pkgconf_var="PKG_CONFIG_$(printf '%s' "${RUST_TRIPLET}" | tr - _)"
    rustflags_var="CARGO_TARGET_$(printf '%s' "${RUST_TRIPLET}" | tr '[:lower:]-' '[:upper:]_')_RUSTFLAGS"

        BOOTSTRAP_SKIP_TARGET_SANITY=1 \
        CARGO_HOME="$(pwd -P)/.cargo" \
        PKG_CONFIG_ALLOW_CROSS=1 \
        OPENSSL_NO_VENDOR=1 \
        DESTDIR="${dest_dir}" \
        env "${pkgconf_var}=${OS_TRIPLET}-pkg-config" \
            "${rustflags_var}=${RUST_GETRANDOM_RUSTFLAG}" \
    python3 "${rust_src}"/x.py install rustc cargo std --stage 2 -j${parallelism}

    rm -rf "${dest_dir}${prefix}"/share/doc
    rm -rf "${dest_dir}${prefix}"/share/man

    post_package_strip

    install_rust_toolchain_source "${rust_src}" "${dest_dir}${prefix}"/lib/rustlib/src
}
