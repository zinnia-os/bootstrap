#! /bin/sh

repology_id=mlibc
version=b2940912e40922d77683f644fbd24a766489c52d
revision=1
git_url="https://github.com/zinnia-os/mlibc.git"
commit=${version}
shallow=no
imagedeps="meson ninja-build"
hostdeps="pkg-config"
deps="zinnia-headers"

configure() {
    meson_configure \
        -Dheaders_only=true
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install
}
