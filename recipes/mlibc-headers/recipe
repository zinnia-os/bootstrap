#! /bin/sh

repology_id=mlibc
version=a1858073acd9c28b0b03bf43f8b2c8f872858c45
revision=1
git_url="https://github.com/zinnia-os/mlibc.git"
commit=${version}
shallow=no
imagedeps="meson ninja-build"
hostdeps="pkg-config"

configure() {
    meson_configure \
        -Dheaders_only=true
}

build() {
    ninja -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" ninja install
}
