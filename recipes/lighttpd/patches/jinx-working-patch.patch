diff --git lighttpd-clean/src/fdevent.h lighttpd-workdir/src/fdevent.h
--- lighttpd-clean/src/fdevent.h
+++ lighttpd-workdir/src/fdevent.h
@@ -31,6 +31,15 @@
 #define FDEVENT_NVAL   (0x0004)
 #define FDEVENT_RDHUP  0x2000
 
+#elif defined(__zinnia__)
+#define FDEVENT_IN     0x0001
+#define FDEVENT_PRI    0x0004
+#define FDEVENT_OUT    0x0002
+#define FDEVENT_ERR    0x0010
+#define FDEVENT_HUP    0x0008
+#define FDEVENT_NVAL   0x0040
+#define FDEVENT_RDHUP  0x0020
+
 #elif defined(__QNX__) /* QNX specific definitions */
 #define FDEVENT_IN     (0x0001 | 0x0004)
 #define FDEVENT_PRI    0x0008
diff --git lighttpd-clean/src/meson.build lighttpd-workdir/src/meson.build
--- lighttpd-clean/src/meson.build
+++ lighttpd-workdir/src/meson.build
@@ -157,6 +157,11 @@
   conf_data.set('HAVE_@0@'.format(f.underscorify().to_upper()), compiler.has_header_symbol(h, f, args: defs))
 endforeach
 
+if host_machine.system() == 'zinnia'
+  # mlibc declares preadv2, but Zinnia doesn't implement this.
+  conf_data.set('HAVE_PREADV2', false)
+endif
+
 if not(conf_data.get('HAVE_POLL'))
 conf_data.set('HAVE_SYS_SELECT_H', compiler.has_header('sys/select.h'))
 conf_data.set('HAVE_SELECT', compiler.has_function('select', args: defs))
