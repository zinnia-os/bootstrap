#! /bin/sh

from_source=zinnia
revision=1
hostdeps="gcc pkg-config"
deps="core-libs"

configure() {
    meson_configure -Dtools_only=true
}

build() {
    meson_build
}

package() {
    meson_install

    install -Dm644 "${base_dir}/extras/zinnia-utils/dinit.d/devd" "${dest_dir}/etc/dinit.d/devd"
    install -d "${dest_dir}/etc/dinit.d/boot.d"
    touch "${dest_dir}/etc/dinit.d/boot.d/devd"
}
