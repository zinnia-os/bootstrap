#! /bin/sh

repology_id=lightdm
version=e06f2aed1317c82312bd45ed8af027c348933f11
revision=2
git_url="https://github.com/canonical/lightdm.git"
commit=${version}
shallow=no
imagedeps="intltool itstool"
source_imagedeps="intltool gtk-doc-tools yelp-tools"
source_hostdeps="autoconf automake libtool pkg-config"
hostdeps="gcc pkg-config"
deps="core-libs glib2 libgcrypt libx11 libxcb libxklavier openpam dbus xorg-server xorg-xauth xf86-input-evdev adwaita-icon-theme"

prepare() {
    cd "${source_dir}"
    autotools_regen
}

configure() {
    autotools_configure \
        --disable-static \
        --disable-introspection \
        --disable-vala \
        --disable-liblightdm-qt5 \
        --disable-tests \
        --disable-gtk-doc \
        --disable-libaudit \
        --disable-nls \
        --with-greeter-session=lightdm-gtk-greeter \
        --with-user-session=weston
}

build() {
    make -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install

    cp -rp "${base_dir}/extras/lightdm/." "${dest_dir}/"
    chmod 0755 "${dest_dir}/etc/lightdm/Xsession" "${dest_dir}/etc/lightdm/setup-runtime-dir" "${dest_dir}/etc/lightdm/desktop-caches"

    post_package_strip
}
