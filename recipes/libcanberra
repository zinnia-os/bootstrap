HEOF

    cat > canberra.c <<'CEOF'
#include "canberra.h"
#include <stdlib.h>

struct ca_context { int unused; };
struct ca_proplist { int unused; };

int ca_proplist_create(ca_proplist **p) { if (!p) return CA_ERROR_INVALID; *p = calloc(1, sizeof(**p)); return *p ? CA_SUCCESS : CA_ERROR_OOM; }
int ca_proplist_destroy(ca_proplist *p) { free(p); return CA_SUCCESS; }
int ca_proplist_sets(ca_proplist *p, const char *key, const char *value) { (void)p;(void)key;(void)value; return CA_SUCCESS; }
int ca_proplist_setf(ca_proplist *p, const char *key, const char *format, ...) { (void)p;(void)key;(void)format; return CA_SUCCESS; }
int ca_proplist_set(ca_proplist *p, const char *key, const void *data, size_t nbytes) { (void)p;(void)key;(void)data;(void)nbytes; return CA_SUCCESS; }

int ca_context_create(ca_context **c) { if (!c) return CA_ERROR_INVALID; *c = calloc(1, sizeof(**c)); return *c ? CA_SUCCESS : CA_ERROR_OOM; }
int ca_context_set_driver(ca_context *c, const char *driver) { (void)c;(void)driver; return CA_SUCCESS; }
int ca_context_change_device(ca_context *c, const char *device) { (void)c;(void)device; return CA_SUCCESS; }
int ca_context_open(ca_context *c) { (void)c; return CA_SUCCESS; }
int ca_context_destroy(ca_context *c) { free(c); return CA_SUCCESS; }
int ca_context_change_props(ca_context *c, ...) { (void)c; return CA_SUCCESS; }
int ca_context_change_props_full(ca_context *c, ca_proplist *p) { (void)c;(void)p; return CA_SUCCESS; }
int ca_context_play_full(ca_context *c, uint32_t id, ca_proplist *p, ca_finish_callback_t cb, void *userdata) { (void)c;(void)p; if (cb) cb(c, id, CA_SUCCESS, userdata); return CA_SUCCESS; }
int ca_context_play(ca_context *c, uint32_t id, ...) { (void)c;(void)id; return CA_SUCCESS; }
int ca_context_cache_full(ca_context *c, ca_proplist *p) { (void)c;(void)p; return CA_SUCCESS; }
int ca_context_cache(ca_context *c, ...) { (void)c; return CA_SUCCESS; }
int ca_context_cancel(ca_context *c, uint32_t id) { (void)c;(void)id; return CA_SUCCESS; }
int ca_context_playing(ca_context *c, uint32_t id, int *playing) { (void)c;(void)id; if (playing) *playing = 0; return CA_SUCCESS; }

const char *ca_strerror(int code) { (void)code; return "(canberra stub)"; }
CEOF

    ${TARGET_CC} ${TARGET_CFLAGS} -fPIC -Iinclude -shared \
        -Wl,-soname,libcanberra.so.0 -o libcanberra.so.0.30 canberra.c
}

package() {
    mkdir -p "${dest_dir}${prefix}/lib/pkgconfig" "${dest_dir}${prefix}/include"
    install -m644 include/canberra.h "${dest_dir}${prefix}/include/canberra.h"
    install -m755 libcanberra.so.0.30 "${dest_dir}${prefix}/lib/libcanberra.so.0.30"
    ln -sf libcanberra.so.0.30 "${dest_dir}${prefix}/lib/libcanberra.so.0"
    ln -sf libcanberra.so.0 "${dest_dir}${prefix}/lib/libcanberra.so"

    cat > "${dest_dir}${prefix}/lib/pkgconfig/libcanberra.pc" <<PEOF
prefix=${prefix}
exec_prefix=\${prefix}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: libcanberra
Description: XDG Sound Theme implementation (Zinnia no-op stub)
Version: ${version}
Libs: -L\${libdir} -lcanberra
Cflags: -I\${includedir}
PEOF

    post_package_strip
}
