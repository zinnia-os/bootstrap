#! /bin/sh

repology_id="llvm"
version=23.1.2
revision=1
tarball_url=https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${version}.tar.gz
tarball_blake2b="b170d1cd9c72c9e4f3909064a3b90a06398f6a5ac164b46d3c373262b4da34d09b4a9932ac320cbd28c8badab085d8303c963ed5fae3f7a5a4224e631372aca8"
imagedeps="build-essential"
hostdeps="gcc pkg-config cmake"
deps="core-libs ncurses zlib zstd libffi"

configure() {
        cmake_source_dir="${source_dir}/llvm" \
    cmake_configure \
        -UBUILD_SHARED_LIBS \
        -UENABLE_STATIC \
        -UCLANG_EXECUTABLE_VERSION \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_FFI=ON \
        -DLLVM_ENABLE_EH=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_PROJECTS="clang;lld" \
        -DLLVM_DEFAULT_TARGET_TRIPLE=${OS_TRIPLET} \
        -DLLVM_HOST_TRIPLE=${OS_TRIPLET} \
        -Wno-dev
}

build() {
    cmake --build . -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" cmake --install .

    rm -rf "${dest_dir}${prefix}"/lib/*.a
    # rm -rf "${dest_dir}${prefix}"/bin

    post_package_strip
}
