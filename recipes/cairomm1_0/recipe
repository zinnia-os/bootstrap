#! /bin/sh

version=1.14.6
revision=1
tarball_url="https://www.cairographics.org/releases/cairomm-${version}.tar.xz"
tarball_blake2b="3d636795678fa566e05b576e70f956049a69505a7e3b0c64e9a8a933c14b97524e6fe13e2036e0e8aff67f4bdd804b9dfc9353f47795d5edf30ccbbb031a1b91"
hostdeps="gcc pkg-config"
deps="core-libs cairo glibmm2"

configure() {
    meson_configure \
        -Dbuild-documentation=false \
        -Dbuild-examples=false \
        -Dbuild-tests=false
}

build() {
    meson compile -j${parallelism}
}

package() {
    DESTDIR="${dest_dir}" meson install --no-rebuild

    post_package_strip
}
