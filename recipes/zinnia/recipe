#! /bin/sh

version=0.2.0
revision=1
git_url=https://github.com/zinnia-os/zinnia.git
commit=bf24abba8efc185d689a1b53adf08b819b7c9a9a
source_dir="kernel"
allow_network=yes
source_imagedeps="git"
source_allow_network=yes
skip_pkg_check=yes
imagedeps="build-essential python3-kconfiglib"
hostdeps="llvm"

prepare() {
    git submodule update --init --recursive
}

configure() {
    srctree="${source_dir}" ARCH="${JINX_ARCH}" python3 -m alldefconfig
    meson_configure \
        -Dconfig_path="$(pwd)/.config" \
        --cross-file "${source_dir}/toolchain/${JINX_ARCH}.cross-file"
}

build() {
    meson_build
}

package() {
    meson_install
}
