#!/usr/bin/env python3
import os
import subprocess
import sys

llvm_config = '/usr/local/bin/llvm-config'
target = os.environ.get('TARGET')
if target and not target.endswith('-zinnia-mlibc'):
    os.execv(llvm_config, ['llvm-config', *sys.argv[1:]])

sysroot = os.environ.get('LLVM_CONFIG_SYSROOT', '/sysroot')
output = subprocess.check_output([llvm_config, *sys.argv[1:]], text=True)
sys.stdout.write(output.replace('/usr/local', f'{sysroot}/usr'))
